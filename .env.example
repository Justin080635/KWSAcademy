# GEMINI_API_KEY: Optional for AI-assisted features if enabled in later stages.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Staff Administration & RBAC Authentication
# Option A: Role passcodes (minimum 6 chars; 12+ recommended)
KWS_ADMIN_PASSCODE=""
KWS_ADVISOR_PASSCODE=""
KWS_VIEWER_PASSCODE=""
KWS_SESSION_SECRET=""

# Option B: Account-based staff credentials & email allowlist
# Example KWS_STAFF_ACCOUNTS: [{"email":"admin@kwsacademy.com","name":"Ada Admin","passcode":"...","role":"admin"}]
KWS_STAFF_ACCOUNTS=""
# Optional comma-separated email allowlist (e.g. "admin@kwsacademy.com,advisor@kwsacademy.com")
KWS_STAFF_ALLOWLIST=""

# SQLite Persistence & Backup Configuration
# Optional explicit SQLite database file path (defaults to ./data/kws_academy.db)
KWS_DB_PATH=""
# Optional directory for database & backups (defaults to ./data)
KWS_DATA_DIR=""

# Optional Outbound Report / Notification Webhook
# When configured, completed submissions post a structured notification payload to this URL.
KWS_REPORT_WEBHOOK_URL=""

# Outbound Email Workflow (Provider: resend | sendgrid | webhook)
KWS_EMAIL_PROVIDER=""
KWS_RESEND_API_KEY=""
KWS_SENDGRID_API_KEY=""
KWS_EMAIL_WEBHOOK_URL=""
KWS_EMAIL_FROM="KWS Academy <admissions@kwsacademy.org>"
KWS_EMAIL_RESULTS_ENABLED="false"

# Official WhatsApp Business API (Provider: meta_cloud | twilio | webhook)
KWS_WHATSAPP_PROVIDER=""
KWS_WHATSAPP_API_TOKEN=""
KWS_WHATSAPP_PHONE_NUMBER_ID=""
KWS_TWILIO_ACCOUNT_SID=""
KWS_WHATSAPP_FROM=""
KWS_WHATSAPP_WEBHOOK_URL=""

# CRM & Email Audience Sync (Readiness / Optional Sync)
KWS_MAILCHIMP_API_KEY=""
KWS_MAILCHIMP_AUDIENCE_ID=""
KWS_MAILCHIMP_SERVER_PREFIX=""
KWS_CRM_WEBHOOK_URL=""
KWS_CRM_WEBHOOK_SECRET=""
